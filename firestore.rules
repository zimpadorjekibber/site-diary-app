rules_version = '2';

// Firestore security rules for Shram & Site Diary.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// A ledger belongs to a Google account. `ownerUid` on the document says whose,
// and nothing outside that account can read or write it — knowing the site id
// is no longer enough, and was only ever enough because there was nothing else
// to go on.
//
// The site id still matters: it names the document, and the shape check below
// keeps anything that is not this app's payload from replacing one. But it is
// a name now, not a password.
//
// Listing is refused outright, so the collection cannot be walked. That is why
// a signed-in phone finds its own ledgers through /user_sites/{uid} instead of
// by querying — see the note there.

service cloud.firestore {
  match /databases/{database}/documents {

    match /site_diaries/{siteId} {

      // site-XXXX-XXXX, using the same alphabet as randomCode() in storage.js.
      function isWellFormedSiteId() {
        return siteId.matches('^site-[A-Z2-9]{4}-[A-Z2-9]{4}$');
      }

      // Two shapes are accepted. The current one keeps each job in `projects`;
      // the older flat one is still written by phones that have not updated yet,
      // and rejecting those would silently stop their backups.
      function isCurrentShape() {
        return request.resource.data.keys().hasOnly([
                 'projects', 'activeProjectId', 'lending', 'settings',
                 'lastWriterDeviceId', 'updatedAt', 'timestamp', 'ownerUid'
               ])
               && request.resource.data.projects is list;
      }

      function isLegacyShape() {
        return request.resource.data.keys().hasOnly([
                 'trades', 'workers', 'transactions', 'haziri', 'haziriMeta',
                 'diaryNotedDates', 'isCleanStarted', 'settings',
                 'lastWriterDeviceId', 'updatedAt', 'timestamp', 'ownerUid'
               ])
               && request.resource.data.workers is list
               && request.resource.data.trades is list
               && request.resource.data.transactions is list;
      }

      function looksLikeLedger() {
        return isCurrentShape() || isLegacyShape();
      }

      /* Ownership. A document written before accounts existed has no ownerUid
         and is therefore unreachable — deliberately: such a ledger is one
         nobody can prove belongs to them, and the app's own file backup is the
         way back into it, not a rule that trusts whoever knows the code. */
      function isClaimed() {
        return resource != null && 'ownerUid' in resource.data;
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      /* Every ledger belongs to an account, from the moment it is created.

         The id alone used to be enough, because there was nothing else to go
         on. That was defensible while one contractor ran one site he had set
         up himself; it is not defensible once strangers install this, because
         it means anyone holding a code holds a ledger, and a ledger that was
         never claimed cannot be got back after a reinstall.

         A ledger is therefore created signed-in and owned, or not at all. */
      allow get: if isWellFormedSiteId() && isClaimed() && isOwner();
      allow list: if false; // never allow enumerating sites
      allow create: if isWellFormedSiteId() && looksLikeLedger()
                    && request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isWellFormedSiteId() && looksLikeLedger() && isClaimed() && isOwner()
                    && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false; // the app never deletes a site document
    }

    /* Which ledgers belong to one signed-in person.

       Rules forbid listing site_diaries — that is what stops a stranger walking
       the collection — so a signed-in phone cannot ask "which site is mine?" by
       querying. It reads this instead: one document per account, holding the ids
       it has claimed. That is the whole of what a new phone needs after a Google
       sign-in, and it is why the site id can finally leave the settings screen.

       Only the account itself can read or write its own row, so this directory
       never becomes a way to discover somebody else's id. */
    match /user_sites/{uid} {
      function isSelf() { return request.auth != null && request.auth.uid == uid; }

      allow get: if isSelf();
      allow list: if false;
      /* siteIds is checked only when it is actually there. A field written by a
         transform — arrayUnion and its relatives — is applied after these rules
         run, so it can be missing from request.resource.data while the write
         plainly contains it, and an unguarded "is list" then refuses a write
         that is perfectly well formed. The app writes a plain array for exactly
         that reason; this guard means a transform would not lock anyone out
         either. hasOnly still fixes which fields may be written at all. */
      allow create, update: if isSelf()
                            && request.resource.data.keys().hasOnly(['siteIds', 'updatedAt'])
                            && (!('siteIds' in request.resource.data)
                                || (request.resource.data.siteIds is list
                                    && request.resource.data.siteIds.size() <= 50));
      allow delete: if false;
    }

    // Anything outside site_diaries is not part of this app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
