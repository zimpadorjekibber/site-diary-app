rules_version = '2';

// Firestore security rules for Shram & Site Diary.
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Context: the app has no sign-in. Every install generates its own unguessable
// site id (site-XXXX-XXXX, see getOrCreateSiteId in src/storage.js) and that id
// is the only thing protecting a site's ledger. These rules therefore do two
// things the default test-mode rules do not:
//
//   1. Refuse access to any document whose id is not a well-formed site id, so
//      a scan of short or guessed names finds nothing.
//   2. Refuse writes that do not look like this app's payload, so a malformed
//      or oversized document cannot replace a real ledger.
//
// They deliberately do NOT allow listing the collection: without that, an
// attacker cannot enumerate sites, only guess full ids (32^8 combinations).
//
// If you later add Firebase Authentication, tighten `isOwner()` below to compare
// request.auth.uid against an ownerUid field on the document.

service cloud.firestore {
  match /databases/{database}/documents {

    match /site_diaries/{siteId} {

      // site-XXXX-XXXX, using the same alphabet as randomCode() in storage.js.
      function isWellFormedSiteId() {
        return siteId.matches('^site-[A-Z2-9]{4}-[A-Z2-9]{4}$');
      }

      // Two shapes are accepted. The current one keeps each job in `projects`;
      // the older flat one is still written by phones that have not updated yet,
      // and rejecting those would silently stop their backups.
      function isCurrentShape() {
        return request.resource.data.keys().hasOnly([
                 'projects', 'activeProjectId', 'lending', 'settings',
                 'lastWriterDeviceId', 'updatedAt', 'timestamp', 'ownerUid'
               ])
               && request.resource.data.projects is list;
      }

      function isLegacyShape() {
        return request.resource.data.keys().hasOnly([
                 'trades', 'workers', 'transactions', 'haziri', 'haziriMeta',
                 'diaryNotedDates', 'isCleanStarted', 'settings',
                 'lastWriterDeviceId', 'updatedAt', 'timestamp', 'ownerUid'
               ])
               && request.resource.data.workers is list
               && request.resource.data.trades is list
               && request.resource.data.transactions is list;
      }

      function looksLikeLedger() {
        return isCurrentShape() || isLegacyShape();
      }

      /* Ownership, added when the app learned to sign in.

         Until a ledger is claimed it behaves exactly as it always has: the site
         id is the only key, which is what every phone in the field still relies
         on. The moment someone signs in and claims it, `ownerUid` is written and
         the id alone stops being enough — knowing the code no longer gets you
         in, the account does.

         Both halves have to stay true at once for as long as there are phones
         on the old build, which is why this is a property of the document and
         not a flag in the rules. */
      function isClaimed() {
        return resource != null && 'ownerUid' in resource.data;
      }

      function isOwner() {
        return request.auth != null && request.auth.uid == resource.data.ownerUid;
      }

      // A claim can be made by whoever holds the id — that is today's access
      // rule — but it can never be moved to someone else afterwards.
      function keepsOwner() {
        return !isClaimed()
               || (request.resource.data.ownerUid == resource.data.ownerUid && isOwner());
      }

      // Installs made before per-site ids all wrote to one shared document
      // ('khalen-dairy'). It held only demo data, confirmed with the owner, so it
      // gets no exemption here — nothing outside the site-id pattern is reachable.
      allow get: if isWellFormedSiteId() && (!isClaimed() || isOwner());
      allow list: if false; // never allow enumerating sites
      allow create: if isWellFormedSiteId() && looksLikeLedger();
      allow update: if isWellFormedSiteId() && looksLikeLedger() && keepsOwner();
      allow delete: if false; // the app never deletes a site document
    }

    /* Which ledgers belong to one signed-in person.

       Rules forbid listing site_diaries — that is what stops a stranger walking
       the collection — so a signed-in phone cannot ask "which site is mine?" by
       querying. It reads this instead: one document per account, holding the ids
       it has claimed. That is the whole of what a new phone needs after a Google
       sign-in, and it is why the site id can finally leave the settings screen.

       Only the account itself can read or write its own row, so this directory
       never becomes a way to discover somebody else's id. */
    match /user_sites/{uid} {
      function isSelf() { return request.auth != null && request.auth.uid == uid; }

      allow get: if isSelf();
      allow list: if false;
      allow create, update: if isSelf()
                            && request.resource.data.keys().hasOnly(['siteIds', 'updatedAt'])
                            && request.resource.data.siteIds is list
                            && request.resource.data.siteIds.size() <= 50;
      allow delete: if false;
    }

    // Anything outside site_diaries is not part of this app.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
