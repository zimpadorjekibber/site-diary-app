{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "vercel-public",
  "framework": null,
  "rewrites": [
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/mcp/:token", "destination": "/api/mcp" },
    { "source": "/register", "destination": "/api/mcp" },
    { "source": "/authorize", "destination": "/api/mcp" },
    { "source": "/token", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-authorization-server/:path*", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource/:path*", "destination": "/api/mcp" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp" },
    { "source": "/.well-known/openid-configuration", "destination": "/api/mcp" }
  ]
}
