{
  "name": "site-diary-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "vite build && cap sync android",
    "apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "apk:release": "npm run sync && cd android && gradlew.bat assembleRelease",
    "rules:deploy": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "sharp": "^0.35.4",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.19.0"
  }
}
